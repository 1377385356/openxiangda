  "status": "reviewed",
  "title": "\u6d41\u7a0b\u8bbe\u8ba1\u3001\u72ec\u7acb\u529e\u7406\u4e0e\u516c\u5f00\u5951\u7ea6\u914d\u5957\u53d1\u884c",
  "summary": "\u6b63\u5f0f\u53d1\u884c\u5df2\u8bc4\u5ba1\u7684\u6d41\u7a0b\u8bbe\u8ba1\u3001\u529e\u7406\u8282\u70b9\u3001\u5171\u4eab\u6570\u636e\u4fdd\u5b58\u3001\u7ed3\u6784\u5316\u5e76\u884c\u3001\u63d0\u9192\u901a\u77e5\u548c\u6d41\u7a0b\u6e90\u7801\u540c\u6b65\u80fd\u529b\uff0c\u63d0\u4f9b\u53ef\u7f16\u8f91\u5e94\u7528\u6a21\u677f\u3001\u8d44\u6e90\u5f15\u7528\u8bfb\u53d6\u4e0a\u4e0b\u6587\u53ca\u53ea\u8bfb AI \u56de\u6267\u6838\u5bf9\uff0c\u540c\u65f6\u4fee\u590d\u9996\u6b21\u5bfc\u5165\u524d\u7684\u6e90\u57fa\u7ebf\u6bd4\u8f83\u548c\u914d\u7f6e\u5199\u5165\u8fb9\u754c\u3002\u516c\u5f00 SDK \u4e0e contracts 2.79.1 \u4f7f\u7528\u540c\u4e00\u51bb\u7ed3\u5206\u53d1\u3002",
  "newFeatures": [
    "\u6d41\u7a0b\u8bbe\u8ba1\u3001\u53d8\u91cf\u548c\u76ee\u6807\u76ee\u5f55\u3001\u7ba1\u7406\u5458\u914d\u7f6e\u3001\u8bbe\u8ba1\u63d0\u6848\u53ca\u5386\u53f2\u5b9e\u4f8b\u63a5\u7ba1\u5171\u7528\u89c4\u8303\u5b9a\u4e49\u4e0e\u7eaf\u6821\u9a8c\u89c4\u5219\u3002",
    "\u72ec\u7acb\u529e\u7406\u4e0e\u8865\u6b63\u8282\u70b9\u652f\u6301\u660e\u786e\u5b8c\u6210\u52a8\u4f5c\u3001\u610f\u89c1\u8981\u6c42\u3001\u5171\u4eab\u6570\u636e\u4fdd\u5b58\u3001\u9000\u56de\u7b56\u7565\u3001\u6301\u4e45\u63d0\u9192\u3001\u5e73\u53f0\u901a\u77e5\u548c\u4e3b\u7ba1\u94fe\u89c4\u5219\u3002",
    "\u7ed3\u6784\u5316 parallel/join \u8282\u70b9\u652f\u6301\u6709\u754c\u72ec\u7acb\u5206\u652f\u3001\u5206\u652f\u4f4d\u7f6e\u8bc1\u660e\u53ca\u53d1\u5e03\u6821\u9a8c\uff0c\u4fdd\u7559\u4efb\u52a1\u8fdb\u5165\u65f6\u7684\u6743\u5a01\u4e8b\u5b9e\u3002",
    "\u6d41\u7a0b\u6e90\u7801\u5bfc\u51fa\u3001\u5bfc\u5165\u3001\u7248\u672c\u6ce8\u518c\u548c\u73af\u5883\u540c\u6b65\u4f7f\u7528\u6e90\u6458\u8981\u53ca\u76ee\u6807\u7248\u672c\u5b88\u536b\uff0c\u4fdd\u7559\u51c6\u5907\u7248\u672c\u5386\u53f2\u3002",
    "\u53ef\u7f16\u8f91\u6a21\u677f\u8986\u76d6\u540e\u53f0\u3001PC\u3001\u79fb\u52a8\u7aef\u548c\u767b\u5f55\u5916\u89c2\uff0c\u8d44\u6e90\u9875\u63a7\u5236\u5668\u3001\u6765\u6e90\u6458\u8981\u53ca\u7ec4\u5408\u6821\u9a8c\u5171\u7528\u6807\u51c6\u8fb9\u754c\u3002",
    "\u8d44\u6e90\u5f15\u7528\u7b5b\u9009\u4f7f\u7528\u72ec\u7acb\u8bfb\u53d6\u610f\u56fe\uff1b\u666e\u901a\u5173\u8054\u7f16\u8f91\u63d0\u4f9b\u8bb0\u5f55 id/revision \u548c\u5b9e\u9645\u7f16\u8f91\u4e0a\u4e0b\u6587\uff0c\u7531\u5e73\u53f0\u5408\u5e76\u6743\u5a01\u7ed1\u5b9a\u3002",
    "AI \u6838\u5bf9\u901a\u8fc7\u53ea\u8bfb GET/read \u67e5\u8be2\u539f\u5e42\u7b49\u952e\u7684\u63d0\u4ea4\u56de\u6267\uff0c\u4e0d\u91cd\u65b0\u6267\u884c\u4e1a\u52a1\u547d\u4ee4\u3002"
  ],
  "fixes": [
    "\u9996\u6b21\u5bfc\u5165\u524d\u6309\u76ee\u6807\u5e94\u7528\u58f0\u660e\u6bd4\u8f83\u6d41\u7a0b\u6e90\u72b6\u6001\uff0c\u5ffd\u7565\u5176\u4ed6\u73af\u5883\u89c2\u5bdf\uff0c\u590d\u7528\u89c4\u8303\u6458\u8981\u3001\u6821\u9a8c\u6e90\u9501\u5e76\u5c06\u5199\u5165\u9650\u5b9a\u4e8e\u5e94\u7528\u5bfc\u51fa\u7684\u914d\u7f6e\u3002",
    "\u5e76\u884c\u5206\u652f\u5361\u7247\u5c45\u4e2d\u4e14\u6761\u4ef6\u5f00\u5173\u4fdd\u6301\u5355\u884c\uff0c\u5ba1\u6279\u5e03\u5c40\u7ee7\u7eed\u4fdd\u7559\u6743\u9650\u3001CAS\u3001\u5e42\u7b49\u548c\u672a\u77e5\u7ed3\u679c\u6062\u590d\u3002",
    "\u65b0\u589e\u6d41\u7a0b\u89c4\u5219\u4f7f\u7528\u6b63\u5f0f\u516c\u5f00 contracts \u65b0\u7248\u672c\uff0c\u4e0d\u5728\u5df2\u516c\u5f00\u65e7\u7248\u672c\u53f7\u4e0b\u79c1\u6709\u6dfb\u52a0 API\u3002",
    "\u5c01\u5305\u6e05\u5355\u6b63\u786e\u68c0\u67e5 template/list \u547d\u4ee4\uff0c\u53c2\u8003\u5019\u9009\u4ed3\u5e93\u652f\u6301\u663e\u5f0f\u4efb\u52a1\u4ee3\u7406\u8bbf\u95ee\u5b98\u65b9\u4e0a\u6e38\u3002"
  ],
  "affectedUsers": [
    "\u4f7f\u7528\u6d41\u7a0b\u8bbe\u8ba1\u3001\u72ec\u7acb\u529e\u7406\u3001\u5171\u4eab\u4fdd\u5b58\u3001\u63d0\u9192\u901a\u77e5\u3001\u6d41\u7a0b\u6e90\u540c\u6b65\u6216\u5386\u53f2\u5b9e\u4f8b\u63a5\u7ba1\u7684 OpenXiangda 2.0 \u5e73\u53f0\u548c\u5e94\u7528\u3002",
    "\u4f7f\u7528\u53ef\u7f16\u8f91\u6a21\u677f\u3001\u8d44\u6e90\u5f15\u7528\u5b57\u6bb5\u6216\u53ea\u8bfb AI \u7ed3\u679c\u6838\u5bf9\u7684 2.0 \u5de5\u4f5c\u533a\u3002"
  ],
  "upgradeSteps": [
    "\u5148\u90e8\u7f72\u4e0e contracts 2.79.1 \u5b9e\u9645\u7eaf\u89c4\u5219\u6458\u8981\u4e00\u81f4\u7684\u5e73\u53f0\uff1b\u670d\u52a1\u5668\u4f7f\u7528\u5b98\u65b9\u516c\u5f00 tarball \u5e76\u6838\u5bf9 SRI\u3002",
    "\u5b8c\u6574\u5de5\u4f5c\u533a\u5206\u53d1\u5347\u7ea7\u5230 openxiangda 2.63.1\uff0c\u6309\u9501\u6587\u4ef6\u5b89\u88c5\u5e76\u5237\u65b0\u8d44\u6599\u53ca MCP \u8fde\u63a5\u3002",
    "\u4fdd\u7559\u539f\u5e94\u7528\u3001\u6570\u636e\u3001\u4efb\u52a1\u3001\u6d41\u7a0b\u7248\u672c\u548c\u5e42\u7b49\u6807\u8bc6\uff0c\u6b63\u5e38 check/deploy \u6838\u5bf9\u5b9e\u9645\u80fd\u529b\u4e0e validatorDigest\u3002",
    "\u6309\u771f\u5b9e\u89d2\u8272\u9a8c\u8bc1\u8bbe\u8ba1\u3001\u4fdd\u5b58\u3001\u529e\u7406\u5b8c\u6210\u3001\u9000\u56de\u3001\u901a\u77e5\u6536\u4ef6\u4eba\u53ca\u5173\u8054\u5b57\u6bb5\u8bfb\u5199\uff0c\u518d\u6267\u884c\u539f\u664b\u7ea7\u6d41\u7a0b\u3002"
  ],
  "knownLimitations": [
    "\u65b0\u589e\u8bfb\u53d6\u4e0a\u4e0b\u6587\u548c\u6d41\u7a0b\u5951\u7ea6\u9700\u8981\u914d\u5957\u5e73\u53f0\u5148\u5347\u7ea7\uff0c\u4fee\u6539\u6458\u8981\u4e0d\u80fd\u4ee3\u66ff\u771f\u5b9e\u517c\u5bb9\u6027\u3002",
    "\u5305\u6d4b\u8bd5\u548c\u6a21\u677f\u5916\u89c2\u4e0d\u4ee3\u66ff\u771f\u5b9e\u89d2\u8272\u3001\u901a\u77e5\u3001\u5b9e\u4f8b\u63a5\u7ba1\u53ca\u4e1a\u52a1\u6570\u636e\u8bfb\u56de\u9a8c\u6536\u3002",
    "\u4e8b\u4ef6\u56de\u6267\u79df\u7ea6\u5bf9\u8c61\u5f52\u5c5e\u548c Worker \u539f\u5b50\u6548\u679c\u4ecd\u4e3a\u72ec\u7acb PLT-040 \u5019\u9009\uff0c\u672c\u6b21\u4e0d\u5305\u542b\u672a\u6574\u5408\u6539\u52a8\u3002"
