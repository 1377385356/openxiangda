{
  "name": "openxiangda-mcp",
  "version": "2.0.5",
  "description": "OpenXiangda 2.0 工作区的结构化 AI 工具与资源。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:release": "node ../../scripts/prune-package-dist.mjs && pnpm build",
    "prepack": "pnpm build:release",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "openxiangda-contracts": "2.3.0",
    "openxiangda-devkit-core": "2.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1377385356/openxiangda.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/1377385356/openxiangda",
  "bugs": {
    "url": "https://github.com/1377385356/openxiangda/issues"
  }
