  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.70.1",
    "status": "reviewed",
    "title": "业务待办通知与旧审批当前节点接续",
    "summary": "应用事务可通过签名事件创建和结束真实待办；管理员可使用正式迁移回执将旧审批接续到原当前节点，保留原申请人与审批轮次。",
    "newFeatures": [
      "事件订阅显式声明 business-task 与任务代码清单，Nest sendTaskFromEvent 投影原事件并复用平台任务中心、通知发件箱及结束状态。",
      "CLI 与 MCP 共享 workflows.legacy-prepare、workflows.legacy-apply、workflows.legacy-receipt 有界管理操作；旧审批历史作为来源事实保留。"
    ],
    "fixes": [
      "声明检查器与打包器完整保留待办任务代码清单，应用与平台编译器共同协商 notification-hub-v2.event-tasks。"
    ],
    "affectedUsers": [
      "需要预约审批、排队分配、结算确认等业务待办，或需接入有可靠来源证明的在途旧审批的 V2 应用。"
    ],
    "upgradeSteps": [
      "安装精确 openxiangda 2.70.1 组合并重新生成契约；先部署同源平台 contracts、后端及旧审批接续 SQL。",
      "业务状态与不可变待办事件同事务；旧审批先正式导入原业务单，再准备和执行原节点接续，未知结果查询原回执。"
    ],
    "knownLimitations": [
      "本次 SDK 发行不代表目标平台或应用已部署，也不证明真实角色办理或外部供应方送达。",
      "旧审批接续仅支持可靠身份、完整线性历史、手动审批和内部当前分派；不重放旧通知，不创建替代账号或伪造原申请人登录。",
      "真实消息通道须沿既有发送授权启用；新增任务能力不授权批量补发历史通知。"
    ],
    "compatibility": {
      "node": "Node.js 24 or newer for maintained toolchain",
      "generation": "OpenXiangda V2; V1 unchanged",
      "platform": "须配套正式 contracts、notification-hub-v2.event-tasks 后端及 AddWorkflowLegacyAdoptionsV2 SQL"
    },
    "issues": [],
    "sha256": "d44db59da451ea6bc39a953cb5cefcdfc88241e0129bcdfb6a2d539424b166db",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.70.1"
  }
