  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.38.0",
    "status": "reviewed",
    "title": "OpenXiangda 2.38.0：限时审批代理维护与回执恢复",
    "summary": "标准后台、应用工具与个人页面共享限时审批代理维护，支持合法候选分页、变更核对、修订冲突和原操作回执恢复。",
    "newFeatures": [
      "WorkflowDelegationManager 及浏览器、Devkit、Nest SDK 提供本人职责代理创建、相关规则查询和授权撤销。",
      "预览复用真实代理写路径并完整回滚；执行原子保存规则及回执，同键重放返回原结果。",
      "管理视图区分生效中、尚未开始、已过期、已撤销和资格失效，显示双方姓名、冻结职责修订及当前资格诊断。",
      "现有导航保护增加 preventNavigation，提交中及结果未知时保留原请求，普通未提交草稿可明确放弃。"
    ],
    "fixes": [
      "代理任务显示实际代理人的姓名，创建及办理复核原生账号、职责修订、范围和时间；拒绝重叠的链式或环形代理。",
      "浏览器及 Nest 代理读取、写入严格绑定当前应用环境，拒绝夹带其他环境。"
    ],
    "affectedUsers": [
      "需要临时委托本人审批职责的用户、查看及撤销代理的应用超级管理员、嵌入通用流程维护工具的 V2 开发者。"
    ],
    "upgradeSteps": [
      "升级机器生成的同批 openxiangda 2.38.0、contracts、CLI 及 SDK 组合并更新冻结锁文件；实验室可使用同批本地 tgz。",
      "先执行平台正式 SQL 迁移及升级；workflow.delegation-management@1.0.0 随 Native2 自动提供，无额外开关。",
      "将共享组件草稿回调接入原导航所有者，验证本人创建、管理员撤销、资格变化、旧任务冻结和未知结果恢复。"
    ],
    "knownLimitations": [
      "第一版代理限于本人有效职责和同角色、覆盖范围的成员；超管只有全应用查看和撤销权，不能替他人代建或委托超管身份。",
      "创建和撤销只影响后续分派，已有待办保留原快照；办理仍复核资格及冻结时间窗口。",
      "回执保存提交时结果，当前状态以重新读取的规则为准；回执 404 不代表未提交。",
      "字段权限由页面逻辑负责。本批本地包、实验室执行和浏览器验收分别记录，不代表 npm 发布、完整流程能力计划或学校生产迁移完成。"
    ],
    "issues": [],
    "compatibility": {
      "node": ">=24",
      "workspaceGenerations": "v2",
      "platform": "原 Native Users/AuthZ 与 Workflow owner；新增正式代理修订和回执迁移，稳定生产管理端保留已发布 SDK 组合。",
      "v1": "沿用原 V1 分发与运行时。"
    },
