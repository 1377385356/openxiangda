  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.22.1",
    "status": "reviewed",
    "title": "OpenXiangda 2.22.1：平台传输失败诊断",
    "summary": "为 Connected Dev、检查和部署控制面请求补充稳定、脱敏的传输失败诊断，使开发者能够区分请求超时与其他网络连接失败，并定位到具体请求阶段，而不泄露平台地址、查询参数或凭据。",
    "newFeatures": [],
    "fixes": [
      "平台请求尚未取得 HTTP 响应时，统一返回 OPENXIANGDA_PLATFORM_REQUEST_TIMEOUT 或 OPENXIANGDA_PLATFORM_TRANSPORT_FAILED，并附带客户端 requestId、HTTP method、脱敏相对路径和限长 cause code。",
      "Connected Dev 顶层诊断会保留稳定错误码、可重试标记和具体失败端点；制品上传仍维持原有专用错误合同，不增加自动重试或 Dev Session 副作用。"
    ],
    "affectedUsers": [
      "通过 VPN、堡垒网络或其他私网连接平台，且需要排查 openxiangda dev、check 或 deploy 预检连接失败的 OpenXiangda 2.0 开发者和平台维护人员。"
    ],
    "upgradeSteps": [
      "将应用对 openxiangda 的精确依赖升级到 2.22.1，按锁文件重新安装依赖，并执行 pnpm openxiangda skill install --force 刷新本地 Skill。",
      "连接目标平台前先确认 VPN 和目标私网路由；若诊断显示请求尚未取得响应，应使用客户端 requestId 和脱敏端点定位本地网络阶段，不要假定平台服务端已收到请求。"
    ],
    "knownLimitations": [
      "传输失败时的 requestId 由客户端生成，仅用于本地关联；请求未到达 nginx 或平台服务时不会产生对应服务端日志。",
      "本版本只改善诊断，不会自动恢复 VPN、代理、DNS 或路由，也不会自动重建 Dev Session。"
    ],
    "issues": [],
    "compatibility": {
      "node": ">=24",
      "workspaceGenerations": "v2",
      "platform": "不要求平台服务或数据库升级；现有 OpenXiangda 2.0 平台 API 合同保持不变。",
      "v1": "V1 工作区与维护引擎不受影响。"
    },
    "sha256": "8ef92b92e9b992bc29703c2063f26b472a873fbf4599cd52f22e7809a8b7c840",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.22.1"
  }
