  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.20.1",
    "status": "reviewed",
    "title": "OpenXiangda 2.20.1：contracts 资源级审计列排序修复",
    "summary": "openxiangda-contracts 修复资源级 surface list defaultSort 对平台审计列（created_at/updated_at 等）的 fail-closed 误拒：与命名视图 defaultSort、Data API order 的系统列规则对齐。devkit 与 openxiangda 2.20.0 已含的行为不变。",
    "newFeatures": [
      "资源级 surface list defaultSort 支持平台审计列（created_at/updated_at/created_by/updated_by/id/revision），不再按未知字段 fail-closed；补回归测试。"
    ],
    "fixes": [],
    "affectedUsers": [
      "所有使用数据策略、行级权限、匿名公开访问的 OpenXiangda 2.0 应用开发者与 AI 开发会话。"
    ],
    "upgradeSteps": [
      "应用把 openxiangda 精确钉扎到 2.20.0 并重跑 pnpm openxiangda check；出现新告警/报错时按提示调整策略声明。",
      "使用 created_by 行规则需平台服务端配套版本；升级前请确认平台列车已包含该修复。"
    ],
    "knownLimitations": [
      "created_by 行规则的运行时 WITH CHECK 正向匹配修复仍随平台列车交付。"
    ],
    "issues": [],
    "compatibility": {
      "node": ">=24",
      "workspaceGenerations": "v2",
      "platform": "无强制平台配合要求；created_by 行规则的运行时生效需平台列车跟进。",
      "v1": "V1 工作区不受影响。"
    },
    "sha256": "043a0bdb2615be80b4efff4a9f2e58107965e261e9294050a1decee22a6b7e6c",
