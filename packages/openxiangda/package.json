  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.59.2",
    "status": "reviewed",
    "title": "入口排队观察节奏与同源契约升级",
    "summary": "尊重服务器入口排队查询间隔，并发行主线已评审的owned聚合容量及固定工作流阶段事务能力。",
    "newFeatures": [
      "模型可声明最高1000行的owned聚合容量，缺省500行、单子表500行与原子编辑边界不变。",
      "固定且已协调的工作流阶段可显式启用一次阶段绑定的Native数据事务，并恢复原事务回执。"
    ],
    "fixes": [
      "入口身份读取不再把60秒服务端查询提示压缩为15秒，保留最低间隔、抖动、原截止、取消及权限拒绝边界。",
      "CLI模板使用本次根SDK精确版本，保证新建应用与发行能力一致。"
    ],
    "affectedUsers": [
      "启用入口等待的V2应用，以及使用新增可选owned容量或工作流阶段事务声明的应用。"
    ],
    "upgradeSteps": [
      "精确安装完整同源发行组合；新增契约需匹配平台能力。高并发应用在真实页面和隔离HTTP请求图中校准查询节奏。"
    ],
    "knownLimitations": [
      "本次客户万人复测尚未执行。上轮已登录万人HTTP图30分钟客户端与数据对账通过，严格网关对账仍保留18条已dispatch缺行。",
      "不自动重放业务写入，不扩大权限或刷新原截止；不证明集中SSO、万人同秒提交、浏览器渲染容量或硬件绝对上限。"
    ],
    "issues": [],
    "compatibility": {
      "node": ">=24",
      "platform": "新增声明按目标平台能力协商；共享契约须消费同源版本",
      "v1": "V1不消费本批V2运行时能力"
    },
