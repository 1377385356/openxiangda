  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.5.0",
    "title": "按业务记录恢复原流程命令",
    "status": "reviewed",
    "summary": "浏览器和 Nest 可在重新进入详情时按业务记录查找原流程命令，继续原回执和进度查询。",
    "newFeatures": [
      "增加当前用户范围的流程命令分页查询，支持精确记录、流程和操作筛选，每页最多 50 条。"
    ],
    "fixes": [
      "补齐业务记录已提交但流程事件尚未投影时，从列表重新进入详情无法定位原命令的恢复路径。"
    ],
    "affectedUsers": [
      "使用 Business Process 原子提交业务数据与流程的 V2 应用开发者。"
    ],
    "compatibility": {
      "node": ">=24",
      "workspaceGenerations": [
        "v1",
        "v2"
      ],
      "v1Policy": "V1 引擎和已有应用不变。",
      "platformPolicy": "使用 Business Process 的新编译包要求 durable-command 1.1.0 和匹配的共享校验器；旧客户端继续兼容。"
    },
    "upgradeSteps": [
      "将应用精确依赖升级至 openxiangda 2.5.0，更新锁文件并刷新技能资料。",
      "平台部署匹配版本后执行检查和测试发布，验证重新进入详情时恢复原命令而不重复提交。"
    ],
    "knownLimitations": [
      "查询沿用原命令的发起人或既有超级管理员权限，记录读取权限不授予他人命令访问。",
      "同一记录可能有多次流程，应用须根据业务约束选择原命令，不能任意选择第一条。",
      "包发布、平台部署和实际业务验收分别验证。"
    ],
    "issues": [],
    "sha256": "35a3bd6f8f97d3261243e1c65e2876a946448c5af455f43ababf18bd8f6f3653",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.5.0"
  }
