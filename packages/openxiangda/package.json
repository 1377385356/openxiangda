  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.1.1",
    "title": "OpenXiangda 应用源码托管",
    "status": "reviewed",
    "summary": "私有化平台通过共享 Forgejo 管理应用源码。创建应用时自动初始化私有仓库并推送代码，应用管理员自动获得仓库管理权限，开发者使用长期 Git 凭据。",
    "newFeatures": [
      "新增 source status、source setup 和 source push 命令，支持初始化恢复和已有工作区接入。",
      "创建应用后自动提交并推送初始源码，通过系统凭据管理器保存个人 Git 凭据。",
      "配套平台支持首次部署前浏览源码及最近提交，并核验部署关联的提交已经推送。"
    ],
    "fixes": [
      "应用源码可直接保留在平台托管仓库中，减少对开发者个人 Git 服务的依赖。",
      "显式导入保留原 origin 为 external-source，初始化重试保留已有未提交修改，冲突推送不覆盖远端提交。"
    ],
    "affectedUsers": [
      "使用 OpenXiangda 2.0 创建应用或接入平台源码仓库的开发者。",
      "维护内部私有化平台和应用管理员权限的平台管理员。"
    ],
    "compatibility": {
      "node": ">=24",
      "workspaceGenerations": [
        "v1",
        "v2"
      ],
      "v1Policy": "V1 应用保持原代际、版本锁定与登录绑定。",
      "platformPolicy": "自动源码托管需要匹配的平台后端、管理前端和网关，并配置 OPENXIANGDA_SOURCE_*；未启用的站点保持原创建行为。",
      "gitCredential": "支持 macOS Keychain、Windows Git Credential Manager，以及 Linux 已安装的 Git Credential Manager 或 libsecret。",
      "releaseChannels": "latest / stable-v2：V2 正式版；legacy-v1：V1 维护版；alpha：预发布。"
    },
    "upgradeSteps": [
      "平台管理员配置共享 Forgejo、源码入口和专用凭据派生密钥，部署匹配的平台版本；长期保留密钥及 Git 数据。",
      "在 Node.js 24 环境安装统一入口：npm install -g openxiangda@2.1.1。",
      "更新 V2 工作区工具链；新应用自动接入，已有应用运行 openxiangda source setup --import 接入。",
      "完成修改后运行 openxiangda source push -m 描述，再按现有检查和部署流程交付。"
    ],
    "knownLimitations": [
      "当前仅同步应用管理员新增授权，不同步撤销或删除。",
      "导入推送当前分支，不自动迁移全部历史分支、标签及 LFS 对象。",
      "制品仍在本地构建；提交存在性核验不构成服务端构建证明。",
      "新源码功能不依赖 Studio；Studio 旧代码移除属于独立后续工作。"
    ],
    "issues": [],
    "sha256": "84347575a9494667fc9f315b27fc44f7242bb48b8ce2893e2f50de246440f53a",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.1.1"
  }
}
