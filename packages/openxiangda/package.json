  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.11.0",
    "status": "reviewed",
    "title": "工作区登录隔离与工具链升级指引",
    "summary": "平台开发者会话按工作区隔离，CLI、MCP 与自动刷新共用本地会话；补齐 V1 采用 V2 的建议及 CLI、Skill、MCP 升级步骤。本版也包含主线已审查的数据事件捕获策略。",
    "newFeatures": [
      "login --cwd 与 auth --cwd 明确选择工作区；创建应用前可在目标目录登录，初始化保留受管会话文件。",
      "V1 入口展示 V2 采用建议及迁移评估指引，文档说明 CLI、Skill 与 MCP 的版本刷新。",
      "应用可用 events.capturePolicies 按资源声明 all 或 subscribed，编译为不可变的操作事件捕获计划。"
    ],
    "fixes": [
      "默认登录态改为工作区 .openxiangda/session.json，停止读取旧全局会话；本地文件优先于 CI 环境凭据。",
      "刷新、退出与 MCP 授权检查固定工作区来源，嵌套应用不会继承父应用账号，损坏或平台不符的文件不会换用其他身份。",
      "登录文件使用原子写入、0600 权限及自动 Git 忽略，初始化不替换凭据内容。"
    ],
    "affectedUsers": [
      "使用 CLI、MCP 或多个应用工作区的开发者。",
      "从 V1 评估 V2 的用户，以及需要减少无消费者事件写入的 Native 应用开发者。"
    ],
    "compatibility": {
      "node": ">=24",
      "workspacePolicy": "升级后在每个工作区重新登录；不自动复制旧全局或其他工作区的令牌。",
      "platformPolicy": "工作区会话不改变身份与授权协议；使用 events.capturePolicies 需要平台提供 events.capture-policy 1.0.0。"
    },
    "upgradeSteps": [
      "使用项目包管理器更新并锁定 OpenXiangda 依赖，刷新 Skill 并重启 MCP 客户端。",
      "已有项目在根目录运行 openxiangda login --base-url <platform>，再运行 auth status 检查授权。",
      "新项目先运行 openxiangda login --cwd my-app --base-url <platform>，然后 create my-app --base-url <platform>。",
      "CI 仅在没有本地会话文件时使用成对 OPENXIANGDA_BASE_URL 与 OPENXIANGDA_TOKEN。",
      "采用事件捕获策略前先升级支持该能力的平台，确认事件历史要求，并完成测试环境验收后晋级同一应用版本。"
    ],
    "knownLimitations": [
      "钉钉支持的 DWS 授权仍由 DWS 自己管理，不与平台会话混用。",
      "V1 业务不会自动迁移到 V2。subscribed 不保留未声明操作的历史，恢复 all 不能补造历史事件。"
    ],
    "issues": [],
    "sha256": "3479087af5f4302a5e225864a60dfc11f337dbaae84a3846f91593971a9c0af0",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.11.0"
  }
}
