  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.41.2",
    "status": "reviewed",
    "title": "OpenXiangda 2.41.2：补填并发核对与拒绝恢复",
    "summary": "任务请求被明确拒绝后读取最新资料，保留本人输入并提供核对。",
    "newFeatures": [
      "renderLayout提供面板当前Surface，自定义详情可以同源展示最新资料。"
    ],
    "fixes": [
      "修复并发补填冲突后始终停留旧版本、无法核对继续的问题。",
      "拒绝后刷新失败显示本次未提交，锁住旧操作；核对区并列最新值和本人输入。"
    ],
    "affectedUsers": [
      "使用代码任务补填页面的V2办理人和嵌入任务面板的应用。"
    ],
    "upgradeSteps": [
      "使用同批本地包并重启连接开发，本轮不发布npm。",
      "自定义详情消费renderLayout.surface，不复制表单或Surface生命周期。"
    ],
    "knownLimitations": [
      "草稿、附件和子表编辑仍属于W13.2。",
      "该修正不代表学校生产迁移或101流程验收。"
    ],
    "issues": [],
    "compatibility": {
      "node": ">=24",
      "workspaceGenerations": "v2",
      "platform": "沿用workflow.task-page-submit@1.0.0，无新SQL或配置开关。",
      "v1": "原V1引擎保持。"
    },
