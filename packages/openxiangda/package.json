  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.49.6",
    "status": "reviewed",
    "title": "基础唯一键的平台预检兼容修复",
    "summary": "修复基础唯一键应用在已支持增强合同的平台上被能力预检误拒，保留实际使用派生及严格边界。",
    "newFeatures": [],
    "fixes": [
      "data.unique-keys要求1.0.0时可使用available的1.1.0平台；不推断未知版本或其他能力的兼容性。"
    ],
    "affectedUsers": [
      "使用既有文本条件唯一键并连接支持data.unique-keys 1.1.0平台的V2开发者。"
    ],
    "upgradeSteps": [
      "按精确完整根发行升级并保留旧锁文件，重新运行目标检查或部署。",
      "应用继续声明原业务唯一键，不修改共享编译器派生的能力要求或删除约束。",
      "本轮仅导出本机完整发行，不执行npm或学校生产发布。"
    ],
    "knownLimitations": [
      "要求1.1.0仍不能使用1.0.0平台；preview/planned/缺失及未知版本继续拒绝。",
      "能力预检不替代平台准备、激活与真实业务验收。"
    ],
    "issues": [],
    "compatibility": {
      "node": ">=24",
      "platform": "既有data.unique-keys 1.0.0与已实现1.1.0的已知兼容关系；validator及应用唯一键语义不变"
    },
    "sha256": "662caf90440646203a04f8cf2398a146cc895fc7259a4f5514786f83a63868ab",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.49.6"
  }
