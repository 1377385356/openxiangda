  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.31.5",
    "status": "reviewed",
    "title": "OpenXiangda 2.31.5：应用 Agent 自定义卡片",
    "summary": "应用可以把填写卡和结果卡的自定义脚本随同一发布版本交付，由平台在隔离卡片 Host 中展示。",
    "newFeatures": [
      "ai.agent.inputCard 和 resultCard 可声明受限的 agent-cards/*.js 资源；发布时核验脚本进入同一前端制品。",
      "openxiangda/agent-card SDK 提供状态接收、只读选项查询、固定任务提交和尺寸同步；中文开发资料与 Skill 给出构建和验收示例。"
    ],
    "fixes": [],
    "affectedUsers": [
      "需要在平台业务 Agent 中展示应用自有填写或结果布局的 OpenXiangda 2.0 应用开发者。"
    ],
    "upgradeSteps": [
      "升级 openxiangda 并更新锁文件；保留标准 inputCard/resultCard 字段声明作为资源失败时的回退。",
      "将使用 SDK 的卡片构建为单文件 IIFE 放入前端 dist/agent-cards/，配置对应 resource，然后运行 check 与预发 deploy。",
      "确认平台已发布配套 Agent 卡片资源端点与隔离 Host；在预发验证歧义选择、刷新、重复提交、权限拒绝与业务回读。"
    ],
    "knownLimitations": [
      "首版消息桥是平台限定协议，不宣称与官方 MCP Apps 线级兼容；卡片只支持已声明的选项查询和固定提交。",
      "结果卡只收到已声明的标量字段；复杂列表、附件和额外工具调用仍需后续独立契约。"
    ],
    "issues": [],
    "compatibility": {
      "node": ">=24",
      "workspaceGenerations": "v2",
      "platform": "自定义卡片需要配套 Agent Center 资源解析服务和无同源 iframe Host。",
      "v1": "独立 V1 引擎和工作区不受影响。"
    },
    "sha256": "b674dd23dcb5fc9e00a7af758f01291295c78b8b6756b43d5f678ba79e4df345",
