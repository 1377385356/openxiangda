  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.53.0",
    "status": "reviewed",
    "title": "独立授权的单记录资料评论",
    "summary": "标准详情提供单记录评论，读取和新增分别声明，同一成员的数据范围与当前用户授权控制服务端执行。",
    "newFeatures": [
      "模型可选recordComments分别配置read/create，编译器自动派生data.record-comments@1.0.0，fresh/update自动执行正式SQL迁移。",
      "平台单记录有界分页、纯文本新增及本人原键回执接口，评论不修改主记录或工作流意见。",
      "公开列表、新增、回执SDK及ResourceRecordComments标准面板，提交不确定时锁定原键并先核对结果。",
      "记录锁与唯一约束保障并发容量及幂等，来源版本与评论回执原子保存。CLI模板随SDK精确升级。"
    ],
    "fixes": [],
    "affectedUsers": [
      "需要独立资料评论权限的V2应用及平台维护者。"
    ],
    "upgradeSteps": [
      "消费同源SDK/contracts/devkit与提供data.record-comments@1.0.0的Server，走正式SQL迁移链。",
      "声明recordComments、同应用能力与职责，保留原资料范围；应用不要为评论另建权限或绕开主记录mutationOwner。",
      "未知结果保留原请求并查本人回执，仅回执不存在时显式同键重试。"
    ],
    "knownLimitations": [
      "未发布npm，实际六组应用授权、普通app-admin与PC/390px浏览器验收待共享平台空闲。",
      "当前仅纯文本评论，不含回复、附件、提及、编辑/删除、通知及旧评论导入；源端附加语义尚未运行核实。",
      "页内导航和关闭浏览器有未完成保护；当前不支持跨刷新自动续写，需保留原键和正文并通过SDK查询原结果。"
    ],
    "issues": [],
    "compatibility": {
      "node": ">=24",
      "platform": "data.record-comments@1.0.0；正式expand SQL新增附属表，未声明应用与已有流程实例保持原行为。"
    },
    "sha256": "6f06443044f74eec12049a8e7c208a84a70a958be5f4495bbdc42e4e953a9184",
