  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.49.5",
    "status": "reviewed",
    "title": "单人资料的条件唯一约束",
    "summary": "Native 唯一键可以按平台用户的稳定身份和布尔启用条件约束有效资料，并由数据库处理并发冲突。",
    "newFeatures": [
      "user.single 支持 exact-v1 唯一键；布尔字段支持 eq/ne 条件。",
      "仅使用新增声明时要求 data.unique-keys 1.1.0，既有规则维持原能力要求。"
    ],
    "fixes": [],
    "affectedUsers": [
      "需要每人仅一份有效资料、同时保留停用历史的 V2 应用开发者。"
    ],
    "upgradeSteps": [
      "使用精确同源 SDK 和支持 data.unique-keys 1.1.0 的平台；通过普通模型声明安装规则。",
      "历史有效资料重复时先按业务处理冲突，平台不会自动删除或停用记录。",
      "本轮仅导出本地密封分发，不执行 npm 发布。"
    ],
    "knownLimitations": [
      "NULL 不参与布尔 eq/ne 条件；规则仍限 8 个，每个最多 4 字段和 4 条件。",
      "已安装规则的删除仍需托管迁移，不通过普通旧版本激活移除。"
    ],
    "issues": [],
    "compatibility": {
      "node": ">=24",
      "platform": "新增声明要求 data.unique-keys 1.1.0；稳定 1.x 与既有唯一键规则不变"
    },
    "sha256": "033fd95bf90f5e242f030ee1b24688dc5358aace39a4477977eb25f08c158429",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.49.5"
  }
