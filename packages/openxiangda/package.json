  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.75.5",
    "status": "reviewed",
    "title": "OpenXiangda 2.75.5：告警优先的应用交付与同源 contracts",
    "summary": "应用 TEST 交付对源码托管和 AppSpec 资料采用告警优先策略，并重新发布当前主线 contracts 制品，保证平台消费的编译器字节与源码提交可核验配对。",
    "newFeatures": [
      "TEST 部署计划和发布支持显式选择 AppSpec 变更；源码托管不可用、资料就绪度或来源观察项会进入警告与发布回执，而不再阻断可继续的 TEST 交付。",
      "生产晋级保留安全、制品完整性、准确 TEST 运行和兼容性等硬门禁，同时将可修复的资料与源码来源观察项作为可见警告。"
    ],
    "fixes": [
      "重新发布 openxiangda-contracts 2.95.5，使平台能够用官方 registry 制品验证当前 OpenXiangda 2.0 master 提交、纯编译器摘要和 tarball 完整性。",
      "根包、CLI、MCP 与 devkit-core 的版本发布保持同一 Changesets 发布单元，避免 CLI 模板与根包版本脱节。",
      "富文本受控字段在父表单暂时未回传最新值时保留编辑器输入，避免工具栏操作触发内容清空。"
    ],
    "affectedUsers": [
      "需要在源码托管服务暂时不可用时继续进行 OpenXiangda V2 TEST 交付的应用开发者。",
      "维护 OpenXiangda V2 平台配套、需要消费同源公开 contracts 制品的发布维护者。"
    ],
    "compatibility": {
      "node": "Node.js 24 or newer for maintained toolchain",
      "generation": "OpenXiangda V2; V1 unchanged",
      "platform": "平台服务端须消费 openxiangda-contracts 2.95.5 官方 archive，并通过来源提交、native compiler 摘要和锁文件完整性校验。",
      "releaseChannels": "latest / stable-v2：V2 正式版；legacy-v1：V1 维护版；alpha：预发布。"
    },
    "upgradeSteps": [
      "先发布并读回同一主线提交生成的 openxiangda-contracts 2.95.5，再将平台 server 的 vendor archive、来源回执和 pnpm 锁文件同步到该版本。",
      "应用 TEST 交付可以继续使用 warning-first 诊断；安全、制品完整性、精确运行和兼容性错误仍需修复后才能继续。",
      "在目标测试环境分别验证 HTTP 运行健康、角色访问、发布回执和实际业务操作；包发布不代表平台部署或业务验收完成。"
    ],
    "knownLimitations": [
      "告警优先只放宽源码托管和 AppSpec 资料类观察项，不放宽安全、完整性、身份、权限、运行时健康或错误目标等硬门禁。",
      "contracts npm 发布、平台镜像部署、应用 TEST 发布和真实业务验收仍是独立证据；本版本不自动修改生产应用。"
    ],
    "issues": [],
    "sha256": "df4ee4daa14549cdb2afb2bc4571a1c721f00d6d2dda6c4b3344de5a3a873750",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.75.5"
  }
