  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.67.0",
    "status": "reviewed",
    "title": "应用Agent接口与事件worker声明修复",
    "summary": "新增作用域内应用Agent客户端，并补齐事件worker编译上下文及节点条件配置契约。",
    "newFeatures": [
      "公开openxiangda/agent客户端与hooks，沿用平台当前身份和持久游标，未知写入不自动重放。"
    ],
    "fixes": [
      "worker-effect编译传入显式emitEventTypes与实际工作流subject，避免合法声明被误拒绝。",
      "配置类型公开worker-effect执行声明，避免应用使用类型绕过。",
      "共享节点人员配置支持完整条件规则与权威来源边界。"
    ],
    "affectedUsers": [
      "OpenXiangda V2应用开发者和平台维护者"
    ],
    "upgradeSteps": [
      "按同批版本升级工具链，重新生成并检查应用契约。",
      "配套升级平台共享契约后验证TEST，真实角色验收独立执行。"
    ],
    "knownLimitations": [
      "事件至少一次投递，依赖原业务意图和平台回执去重。",
      "工具链发布不代表学校平台部署或应用业务验收完成。"
    ],
    "compatibility": {
      "node": ">=24",
      "pnpm": "10.15.1"
    },
    "issues": [],
    "sha256": "535f00f729995cc1f8ce0925c3ddbd5976e1ed6283ef60d2888955ae95393d02",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.67.0"
  }
