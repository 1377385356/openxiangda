  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.66.1",
    "status": "reviewed",
    "title": "事件 worker-effect SDK 导出修复",
    "summary": "保持 2.66.0 worker-effect 能力，并修复根包 Nest 入口导出缺失。",
    "newFeatures": [
      "事件消费者支持受限查询、冻结事务、原键提交与回执恢复；平台统一执行并验证事件租约。"
    ],
    "fixes": [
      "公开 Nest 入口补充导出事件 worker-effect 服务。"
    ],
    "affectedUsers": [
      "需要定时业务事务的 OpenXiangda V2 应用开发者与平台维护者。"
    ],
    "upgradeSteps": [
      "配对升级 SDK、CLI、共享契约和平台服务；为事件订阅显式声明 worker-effect 资源、字段及容量。"
    ],
    "knownLimitations": [
      "投递至少一次，业务事务依赖原幂等意图去重；不允许工作流拥有的资源写入或任意业务身份冒用。"
    ],
    "compatibility": {
      "node": ">=24",
      "pnpm": "10.15.1"
    },
