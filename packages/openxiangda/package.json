  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.58.0",
    "status": "reviewed",
    "title": "有界入口读取恢复与流程、开发配置能力更新",
    "summary": "身份读取在原期限内恢复短暂网络失败；同时交付主线已合入的流程范围、主子事务和开发配置能力。",
    "newFeatures": [
      "具名流程支持保存前范围候选与一层 owned 主子创建闭包，仍由平台按实际资料及职责校验。",
      "流程节点支持有界职责成员并集及可选操作原因，任务使用进入节点时冻结的规则。",
      "显式 owned 子表支持最多500行及有界记录集合事务守卫，保留 CAS、字节与文件限额。",
      "预发布开发配置可同步真实 Native 配置而不构建 Web/Nest 制品，不能晋级生产。",
      "连接开发支持从源码接收有界后端事件交付，保留真实平台租约和确认边界。"
    ],
    "fixes": [
      "身份 GET 不再因第三次短暂传输失败提前退出；采用有界指数退避，保留原恢复截止、单次超时、取消与明确权限拒绝。"
    ],
    "affectedUsers": [
      "使用 V2 入口等待、具名流程、owned 子表或预发布开发配置的应用。"
    ],
    "upgradeSteps": [
      "消费同源完整发行组合，并按声明协商目标平台能力。",
      "入口预约、身份回执恢复和结果查询提示需配套平台更新；更新后重新校准真实页面请求图及性能测试。"
    ],
    "knownLimitations": [
      "本轮尚未完成客户站点部署及新版本容量验收；源码验证不代表线上通过。",
      "入口恢复仅重试读取，不自动重放报名等业务写操作，不续期原 Redis 票据。",
      "此前8000人实验有7989人客户端30分钟内读回，最高完整通过仍5000人；实验不含SSO，不能代替首秒8000人完整浏览器容量结论。"
    ],
    "issues": [],
    "compatibility": {
      "node": ">=24",
      "platform": "按声明协商对应 Native 与流程能力；入口恢复配套平台回执",
      "v1": "V1不消费该V2接口"
    },
    "sha256": "ac8676f79afa9bc596508c7ca897ec60ffadf79f86ca36429dc1a279df23cf09",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.58.0"
  }
