  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.67.2",
    "status": "reviewed",
    "title": "读取范围能力交集与开发诊断修复",
    "summary": "所选读取范围严格收窄当前身份能力，并补充原执行健康、托管文件语义及设计资料预算诊断。",
    "newFeatures": [
      "应用自助操作提供原执行健康和托管文件语义观察，沿用当前身份与原请求。"
    ],
    "fixes": [
      "Perspective读取能力与当前身份能力取交集，避免有限角色选择其他角色的完整管理投影。",
      "AppSpec记录实际读取字节和省略原因，保留现有确认及部署门禁，不将超预算资料误判为不存在。",
      "工作区加载及封包的声明warning不再误当error阻断，真实错误继续拒绝。",
      "发行元数据读取保留有界并发和原渠道状态；CLI模板与根SDK版本配套。"
    ],
    "affectedUsers": [
      "使用多角色读取范围的V2应用开发者及平台维护者"
    ],
    "upgradeSteps": [
      "通过官方精确根包版本安装整组工具链，检查当前平台兼容性后重新部署TEST。",
      "使用有限角色、兼任角色及撤销授权场景核对页面投影；实际业务验收独立于发包。"
    ],
    "knownLimitations": [
      "源码回归不证明学校身份同步、通知通道、定时任务或完整迁移已验收。",
      "读取范围不改变写入和业务动作授权，Native后端继续独立执行字段与行权限。"
    ],
    "compatibility": {
      "node": ">=24",
      "pnpm": "10.15.1"
    },
    "issues": [],
    "sha256": "a6d7741c59762468ee23815832c0d707166bc60ca7913dabd4f945d6cf84ac20",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.67.2"
  }
