{
  "name": "openxiangda",
  "version": "2.1.1",
  "description": "OpenXiangda 2.0 的统一命令、应用 SDK、MCP 与中文 AI 技能资料。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
