  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.54.5",
    "status": "reviewed",
    "title": "具名业务数据命令的原结果恢复",
    "summary": "数据保存成功但响应丢失时，可按原操作键与原业务输入只读恢复 Native 事务结果，保留实际提交版本并避免重复修改。",
    "newFeatures": [
      "BusinessDataApi.commitCommand 与 resolveOriginalCommand 复用平台 Native 回执，绑定真实发起人、应用环境、动作能力和业务意图。",
      "编译器严格校验 dataCommands.mode=recoverable-native，并自动要求 data.business-commands@1.0.0，无额外默认关闭开关。"
    ],
    "fixes": [],
    "affectedUsers": [
      "需要恢复资料修正等具名数据动作原结果的 V2 应用。未声明此能力的应用与 V1 行为保持原合同。"
    ],
    "upgradeSteps": [
      "整体使用同源 SDK 与包含 NamedDataCommandReceiptMetadata 正式 SQL 迁移的平台 Server；在动作代码中于业务校验前恢复原键，首次提交仍执行原业务校验及 Native guards。"
    ],
    "knownLimitations": [
      "本轮为本机测试候选；未发布 npm、未操作学校生产数据。源码和隔离数据库验证不能代替实际应用和角色验收。",
      "not_observed 不是回滚证明；SDK 不自动重试写入或更换键。",
      "本能力不替代动作的同成员资料范围、字段校验或附件输入授权；完整管理员编辑继续由应用与平台输入能力共同实现。",
      "正式 npm 发行验证仍需同源参考应用和发行门禁；本机冻结包消费分别记录。"
    ],
    "issues": [],
    "compatibility": {
      "node": ">=24",
      "platform": "data.business-commands@1.0.0，与 Native 原事务回执的正式元数据迁移。"
    },
