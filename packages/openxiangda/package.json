  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.44.1",
    "status": "reviewed",
    "title": "OpenXiangda 2.44.1：任务附件恢复反馈",
    "summary": "PC 任务上传的错误与恢复结果由任务面板统一显示，恢复成功后不再残留旧网络错误。",
    "newFeatures": [],
    "fixes": [
      "任务上传恢复反馈保留唯一 owner，字段继续显示上传前大小校验。",
      "PC 上传区域在上传中、任务锁定或任务字段满额时禁用并提供 aria-disabled。",
      "CLI 模板依赖与本次 SDK 补丁保持同批。"
    ],
    "affectedUsers": [
      "使用 V2 代码任务附件页面的办理人和应用开发者。"
    ],
    "upgradeSteps": [
      "消费同批 SDK 和 CLI，重新构建本地应用；本次不新增数据库迁移或服务端合同。"
    ],
    "knownLimitations": [
      "根签名、富文本和 owned 子表继续后续任务页面切片。",
      "字段行为归页面代码，流程管理员不配置字段权限。",
      "本轮仅准备本地测试包，未发布 npm 或迁移学校生产。"
    ],
    "issues": [],
    "compatibility": {
      "node": ">=24",
      "workspaceGenerations": "v2",
      "platform": "沿用 workflow.task-managed-files@1.0.0",
      "v1": "1.x 引擎独立。"
    },
