  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.49.8",
    "status": "reviewed",
    "title": "基础唯一键制品合同与编译器派生一致",
    "summary": "修复制品封装对基础唯一键1.0.0的误拒，保留增强1.1.0以及精确使用闭包校验。",
    "newFeatures": [],
    "fixes": [
      "contracts制品语法接受共享编译器实际派生的data.unique-keys基础1.0.0及现行1.1.0。",
      "增加实际compileAppPackage回归，覆盖基础与增强唯一键从配置到制品的完整链路。"
    ],
    "affectedUsers": [
      "使用基础唯一键且目标平台已实现增强1.1.0能力的2.0应用开发者。"
    ],
    "upgradeSteps": [
      "使用精确完整根发行升级，并配套已修复的Server入站制品校验。",
      "重新检查和部署原应用；保留编译器派生需求，不手改contractVersion、usageDigest或唯一键声明。"
    ],
    "knownLimitations": [
      "未知能力、未知版本及其他能力版本差异仍拒绝；语法接受不代表目标能力或部署成功。",
      "增强声明降级为基础仍由精确配置闭包拒绝；权限、数据库唯一约束与激活Head保持原边界。",
      "本批仅本机完整SDK分发，不执行npm或学校生产发布。"
    ],
    "issues": [
      "PLT-013"
    ],
    "compatibility": {
      "node": ">=24",
      "platform": "需配套Server338d5ac3；不改变共享compiler派生、validatorDigest或1.x引擎"
    },
    "sha256": "3cd0baea28368559da50567109bd7fb991089ed4ba00f03f3ffa772108cd24dd",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.49.8"
  }
