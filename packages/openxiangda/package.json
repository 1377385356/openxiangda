    "@nestjs/platform-fastify": "11.1.29",
    "@refinedev/core": "5.0.12",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "antd": "6.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.8.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
