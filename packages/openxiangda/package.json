  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.31.7",
    "status": "reviewed",
    "title": "OpenXiangda 2.31.7：后端受控核验所选组织人员",
    "summary": "应用后端可在已声明的业务操作内核验所选人员，姓名、工号与部门由平台组织架构提供。",
    "newFeatures": [
      "增加 selected-user 目录声明和 BusinessDirectoryService.selectedUser，按声明投影组织身份字段并返回核验快照。"
    ],
    "fixes": [],
    "affectedUsers": [
      "需要管理员代录、身份纠正或针对所选组织人员执行业务操作的 V2 应用。"
    ],
    "upgradeSteps": [
      "升级应用工具链，并先部署支持 directory.selected-user 1.0.0 的平台；在具体后端操作声明所需字段和目录读取权限。"
    ],
    "knownLimitations": [
      "只支持同租户有效组织人员；未声明能力、无目录权限或人员不可用时明确拒绝。"
    ],
    "issues": [],
    "compatibility": {
      "node": ">=24",
      "workspaceGenerations": "v2",
      "platform": "新增能力需要支持 directory.selected-user 1.0.0 的平台；既有 current-initiator 行为不变。",
      "v1": "独立 V1 引擎不受影响。"
    },
    "sha256": "8843f2ad58d915c2b9158821b6640bc4453a5e0e6f6066d918fda0e9dc168ccd",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.31.7"
  }
