  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.7.1",
    "status": "reviewed",
    "title": "OpenXiangda 2.7.1：修复可选后端连接开发",
    "summary": "连接开发按应用配置启动本地 Nest，绑定平台活动应用版本与开发会话，支持已激活前端应用首次启用本地后端。",
    "newFeatures": [],
    "fixes": [
      "不再要求应用手动补根目录 dev:server；使用 backend.root 包内 dev 入口。纯前端应用不启动 Nest。",
      "补齐本地 Nest 所需活动应用版本描述；本地修改的后端使用开发会话标签，不冒充已部署镜像。",
      "开发会话目标发生变化时停止子进程并撤销原会话，防止环境与运行时身份不一致。"
    ],
    "affectedUsers": [
      "使用 dev 连接平台测试环境的纯前端和按需 Nest 应用开发者。"
    ],
    "upgradeSteps": [
      "通过项目正式升级流程采用 openxiangda 2.7.1，刷新项目资料并重启旧 MCP 与 dev 进程。",
      "保留根目录 dev:web，确认配置的后端包具有 dev 启动脚本。"
    ],
    "knownLimitations": [
      "需要平台已有激活应用版本；联调数据写入仍发生在选定远端环境。",
      "本次修复不改变线上应用制品或生产部署。"
    ],
    "compatibility": {
      "node": ">=24",
      "platform": "支持 Application v2 开发会话及活动 AppVersion 的平台"
    },
    "issues": [],
    "sha256": "102d3bdfb8c717e3629dac9eac67eb37f9b50588fda3bf28c9c1930512f4bb75",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.7.1"
  }
