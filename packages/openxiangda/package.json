  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.47.2",
    "status": "reviewed",
    "title": "任务主要操作与附件可访问性",
    "summary": "退回重提按平台主要操作呈现，PC附件上传使用具备禁用和键盘语义的真实按钮。",
    "newFeatures": [],
    "fixes": [
      "手机任务动作排序支持服务端标为主要操作的重新提交。",
      "PC附件上传提供原生按钮、焦点环和禁用状态，避免键盘Enter由按钮与上传容器重复处理。"
    ],
    "affectedUsers": [
      "使用标准任务页面或PC Field Kit附件/图片字段的OpenXiangda 2.0应用。"
    ],
    "upgradeSteps": [
      "按精确版本升级SDK；退回重提主要操作需要平台服务端提供正确descriptor。本批仅本地验证，不执行npm发布。"
    ],
    "knownLimitations": [
      "流程资格、上传与下载协议沿平台现有能力；本批不扩大任务子表容量，也不代表完整学校流程迁移验收。"
    ],
    "compatibility": {
      "node": ">=22.12.0",
      "platform": "OpenXiangda 2.0；不改变1.x运行时"
    },
