  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.9.3",
    "status": "reviewed",
    "title": "OpenXiangda 2.9.3：明确记录用户授权的性能延期",
    "summary": "修复功能验收完成但用户已延期性能时无法正式晋级的问题，保留原测量并明确区分性能通过与延期。",
    "newFeatures": [],
    "fixes": [
      "AppSpec验收报告支持有授权人、实际时间、来源、证据及后续安排的performanceDeferral。",
      "延期时保留真实超标测量，返回deferred与overBudget统计，生产阶段明确显示性能未通过。",
      "没有授权延期时仍要求性能测量达标；延期不豁免功能AC、证据、原测试版本和制品绑定。"
    ],
    "affectedUsers": [
      "已由用户明确延期性能验收、需要按实际范围完成V2功能交付的应用开发者。"
    ],
    "upgradeSteps": [
      "更新项目的openxiangda依赖至2.9.3并刷新项目技能；已有测试制品可以沿用，不因验收工具升级而重建。",
      "依据实际用户决定填写延期记录，保留成功与失败测量；正式spec verify后提交推送报告，用原TEST运行晋级。"
    ],
    "knownLimitations": [
      "结构验证不证明授权或证据内容真实；不得制造用户确认、提高阈值或仅保留成功样本。",
      "本次仅修复开发交付记录契约，不修复性能，也不修改平台后端、业务数据或运行时权限。"
    ],
    "compatibility": {
      "node": ">=24",
      "platform": "沿用openxiangda-contracts 2.7.0，无新增平台能力要求"
    },
    "issues": [],
    "sha256": "aea11cf79206afaae7d6a98eb72506bd71f13752ca6178e459d5395cde4b10a8",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.9.3"
  }
