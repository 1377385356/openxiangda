  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.17.1",
    "status": "reviewed",
    "title": "OpenXiangda 2.17.1：用户标准面共享契约闭合修复",
    "summary": "共享编译器接受并校验生成式用户标准面的路由契约，2.17.0 声明 user 面的应用可完整通过本地校验与部署；生成码分隔符统一为点号。",
    "newFeatures": [
      "生成码分隔符统一为点号（user.资源码.records / user.资源码.submit），与设备路由码一致。"
    ],
    "fixes": [
      "修复 2.17.0 中 user 声明触发 NATIVE_CODE_INVALID / NATIVE_CONTRACT_CLOSURE_MISMATCH：共享校验器按配置事实（资源存在、能力等于 read/create、码与路径形状）校验并并入用户标准路由，配置 bundle 不变，旧平台无需升级。",
      "生成码统一为 user.资源码.records / user.资源码.submit，符合稳定码模式。"
    ],
    "affectedUsers": [
      "使用 openxiangda 2.17.0 并声明 user 用户面的应用开发者。"
    ],
    "upgradeSteps": [
      "应用精确依赖升级到 openxiangda 2.17.1 后重新运行 check 与部署。"
    ],
    "knownLimitations": [
      "“我的记录”的本人过滤仍是查询层展示过滤，非服务端授权边界。"
    ],
    "compatibility": {
      "node": ">=24",
      "workspaceGenerations": [
        "v2"
      ],
      "platform": "无平台配合要求；配置与契约 bundle 对既有平台保持可部署。",
      "v1": "不改变 V1 运行时或应用。"
    },
    "issues": [],
    "sha256": "365186221004ce60f596db55dca2b53bf9d2d89695956b80daa7b3b4cd028af2",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.17.1"
  }
