  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.69.0",
    "status": "reviewed",
    "title": "可信活动组织上下文与匿名记录事件身份配套",
    "summary": "保留平台选择的可信组织上下文，并修复公开申请事件在Nest处理前被错误拒绝的问题。",
    "newFeatures": [
      "浏览器、NativePrincipal和Nest CurrentUser保留可信活动组织；提供当前组织成员、角色事实读取与受同源及CSRF保护的组织切换。"
    ],
    "fixes": [
      "原生记录事件及审计历史接受anonymous_public行为事实；仍拒绝未知身份、空标识和匿名伪造application业务授权。",
      "组织切换或结果未知时失效旧授权与晚到读取，不将认证token放入应用receipt。"
    ],
    "affectedUsers": [
      "使用公开提交及记录事件订阅的V2应用。",
      "使用平台可信组织上下文和组织切换的V2应用。"
    ],
    "upgradeSteps": [
      "升级精确openxiangda 2.69.0官方配套，重新生成契约与检查后部署。",
      "平台使用同一权威SDK提交，组织上下文相关运行能力须使用配套平台；匿名事件恢复使用原delivery而不是重新提交业务。"
    ],
    "knownLimitations": [
      "多组织事实映射及数据权限需平台配套，不代表已有全部应用自动实现组织隔离。",
      "正式发行不等于学校真实角色、页面、通知或迁移验收通过；不扩大匿名Data API权限。"
    ],
    "compatibility": {
      "node": "Node.js 24 or newer for maintained toolchain",
      "generation": "OpenXiangda V2; V1 unchanged",
      "platform": "配套可信活动组织服务端上下文；保留既有签名、manifest、Native授权与公开策略"
    },
    "issues": [
      "PLT-069"
    ],
    "sha256": "cbbfb507d34b8dfcbad3e31f4ef5f7e25b5f1b8b47d3aaaa9288ae54b0c973fb",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.69.0"
  }
