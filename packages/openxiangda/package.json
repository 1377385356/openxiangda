  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.28.0",
    "status": "reviewed",
    "title": "OpenXiangda 2.28.0：应用原操作自助诊断",
    "summary": "应用管理员通过现有工作区查询原请求、持久命令、部署和受管文件的脱敏事实，减少依赖平台人员登录服务器定位问题的情况。",
    "newFeatures": [
      "logs 增加 request-id、command-id、deployment-run-id、file-id 四种互斥定位器，MCP 提供相同范围的 application_diagnostics 只读工具。",
      "结果显示实际站点、应用、环境、时间窗口及观测时间；SDK 校验查询与响应关联，只保留受支持的元数据。"
    ],
    "fixes": [
      "明确区分已观测、未观测和诊断暂不可用；未知结果不再被解释成原操作未执行，也不会触发换键重放。"
    ],
    "affectedUsers": [
      "需要按原操作 ID 自助排查发布、工作流和文件状态的 OpenXiangda 2.0 应用管理员及开发者。"
    ],
    "upgradeSteps": [
      "应用消费 openxiangda@2.28.0 并更新锁文件；使用已有工作区开发者登录，不需要服务器账号。",
      "平台应提供 application.scoped-diagnostics@1；查询默认使用 test，生产环境需显式传 --environment production。",
      "保留原操作 ID。request-id 默认查询最近一小时，也可传一对 UTC from/to，窗口最多 24 小时；其他定位器不接受时间窗口。"
    ],
    "knownLimitations": [
      "诊断受应用管理权限和当前租户、环境约束；普通应用服务凭据不因此获得管理权限。",
      "每次最多返回 50 条事实，可能标记截断；不返回业务正文、文件名、原始日志或密钥。",
      "未观测不表示原写入未发生，已观测不表示业务验收完成。暂不可用时保留原键与输入，按提示继续查询。",
      "此次新增能力不改变共享 Native 编译器摘要；公开包发行与实际站点部署分别验证。"
    ],
    "issues": [],
    "compatibility": {
      "node": ">=24",
      "workspaceGenerations": "v2",
      "platform": "新诊断入口要求 application.scoped-diagnostics@1.0.0 或兼容 1.x；原 logs [deploymentId] 和未使用此能力的应用保持原行为。",
      "v1": "独立 V1 引擎和工作区不受影响。"
    },
    "sha256": "80c18512f5cb76850e738b9e802261af68e27f6582b3f686781da7c9d4367c2a",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.28.0"
  }
