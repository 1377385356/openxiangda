  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.10.0",
    "status": "reviewed",
    "title": "OpenXiangda 2.10.0：通知已读回执基础能力",
    "summary": "浏览器与 Nest SDK 增加通知投递详情、已读回执缓存和单次刷新接口，应用通过平台消息与投递标识使用钉钉已读查询。",
    "newFeatures": [
      "浏览器与 Nest SDK 同步提供 getNotificationMessage、getDingTalkCardReadReceipt 和 refreshDingTalkCardReadReceipt，并公开对应类型。",
      "配套平台保存卡片查询标识，持久化单投递查询任务，区分已读、未读、未知、不可查询和查询失败。",
      "配套平台通用化钉钉卡片发送、查询及总预算，并按资源配置准备和投递并发。"
    ],
    "fixes": [
      "配套平台将钉钉 HTTP 403 QpsLimitForApi 识别为可退避重试的限流响应，保留创建请求结果未知时的既有处理边界。"
    ],
    "affectedUsers": [
      "需要查询钉钉卡片已读状态或使用平台通知 SDK 的 OpenXiangda 2.0 应用开发者。"
    ],
    "compatibility": {
      "node": ">=24",
      "workspaceGenerations": [
        "v1",
        "v2"
      ],
      "v1Policy": "V1 引擎和已有应用不变。",
      "platformPolicy": "已读接口需要匹配的平台后端、通知回执追加迁移，以及通知读取和内容读取权限。",
      "releaseChannels": "latest / stable-v2：V2 正式版；legacy-v1：V1 维护版；alpha：预发布。"
    },
    "upgradeSteps": [
      "先部署匹配的平台后端及追加迁移，按实际钉钉额度配置统一的发送、查询和总预算。",
      "将应用精确依赖升级到 openxiangda 2.10.0，更新锁文件，并通过标准检查。",
      "使用平台消息 ID 和投递 ID 查询缓存或请求一次刷新；应用负责选择消息、分组和后续业务轮询。",
      "在测试环境验证实际投递和已读回执，再使用同一应用候选晋级生产。"
    ],
    "knownLimitations": [
      "一次上游查询针对一个 processQueryKey 下最多 20 名收件人；本版本不提供跨消息批量查询或自动全量轮询。",
      "历史投递没有保存查询标识时返回不可查询，不能推断为未读；查询遵循钉钉提供方的 24 小时窗口。",
      "包发布、平台部署与真实消息验收分别记录；本版本不会自动补发历史失败或未知通知。"
    ],
    "issues": [],
    "sha256": "a1be367ab9c5de6b66ec8dd02724af71611183d99ddb9dae861e6253c58875df",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.10.0"
  }
