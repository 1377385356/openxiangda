{
  "name": "openxiangda",
  "version": "2.66.1",
  "description": "OpenXiangda 2.0 的统一命令、应用 SDK、MCP 与中文 AI 技能资料。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./expressions": {
      "types": "./dist/expressions.d.ts",
      "import": "./dist/expressions.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./field-kit": {
      "types": "./dist/field-kit.d.ts",
      "import": "./dist/field-kit.js"
    },
