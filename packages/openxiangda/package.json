  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.62.0",
    "status": "reviewed",
    "title": "受控事件、机器回调与后台补偿原子写入",
    "summary": "以不可变资源、操作、字段和数量声明支持 action-owned 资源的验证事件、具名机器回调及活动租约 Worker 原子事务，保留默认拒绝、CAS、幂等与原有用户权限。",
    "newFeatures": [
      "platformAccess.dataMutations 固定资源、create/update/delete/increment、字段白名单和单事务数量上限；要求 data.service-mutations 1.0.0 平台能力。",
      "ApplicationDataApiService.transactionFromServiceAction 在机器操作的已验证请求下提交同一个 Native 事务，不把机器冒充用户。",
      "ApplicationDataApiService.withWorkerAction 使用 SDK 活动后台租约并要求 allowRuntimeWorker:true，复用既有回调/补偿服务，支持最多50条履约节点与签署完成件一并提交。"
    ],
    "fixes": [
      "Correction 的业务 resubmit handler 与普通 return_review 标准 Kernel 重提分离；普通退回任务不再错误要求起草 capability，已有固定定义和实例无需重建。"
    ],
    "affectedUsers": [
      "使用 action-owned 资源、审批终态事件或真实机器回调的 OpenXiangda 2.0 应用。",
      "需要权威查询补偿和多记录原子回写的 Scheduler/Worker 应用。"
    ],
    "upgradeSteps": [
      "升级配套平台并核对 data.service-mutations 1.0.0 与完整配置 validatorDigest。",
      "将工作区所有 OpenXiangda 包升级到同一胶囊版本2.62.0并安装锁文件依赖。",
      "事件订阅和机器操作显式声明 dataMutations；后台动作按需显式加 allowRuntimeWorker:true，保持原业务幂等键和各行CAS。",
      "机器请求调用 transactionFromServiceAction；Worker 用 withWorkerAction 包裹现有服务；真实测试环境分别验收事件、回调、补偿和50条整事务回滚。"
    ],
    "knownLimitations": [
      "字段授权不替代外部供应商验签、业务状态守卫、底稿摘要或当前用户成员权限；role-member/actor-authority仍由用户动作拥有。",
      "机器入口使用已有短期网关invocation的有效期；过期结果按原业务号核对，通过活动租约补偿，不延长或伪造证明。",
      "Native事务自身总操作/字段/字节限额仍生效，本文档的maxOperations是单资源额外上限。",
      "生产晋级仍须实际业务验收，不能将包测试或Pod Ready视作签署、通知或财务验收。"
    ],
    "compatibility": {
      "generation": "v2",
      "node": ">=24",
      "platform": "data.service-mutations 1.0.0 and exact configuration validator",
      "v1": "独立1.x维护包不变"
    },
    "issues": [],
    "sha256": "c547759f4a202325b30134e2db40f2bc9bdd05b74fc4da393acd46c2802832a5",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.62.0"
  }
