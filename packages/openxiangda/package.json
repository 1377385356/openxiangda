  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.26.0",
    "status": "reviewed",
    "title": "OpenXiangda 2.26.0：原操作恢复、目标预检与类型化资源",
    "summary": "保留未知提交的原操作，提前汇总目标环境缺项，提供类型化资源、受限角色候选和可复制的安全请求诊断。",
    "newFeatures": [
      "标准 PC/移动审批提交在响应未知时保留原操作定位信息，刷新后读取原回执；同一页面可按原键和冻结输入显式恢复，避免生成新键重复提交。",
      "生成 ResourceTypes 并为 Nest 当前用户、业务动作和事件上下文提供资源绑定，约束资源名、字段、引用和更新 revision。",
      "受信业务动作可读取声明角色的最小候选信息，服务端限定租户、环境、角色和有效期，提交时仍重新授权。"
    ],
    "fixes": [
      "check/deploy 在构建前集中输出目标能力与配置缺项，附实际目标、版本、观测时间和 requestId；诊断信息不会混入封闭的平台响应契约。",
      "新建应用和可选后端依赖安装失败保留安全错误分类与恢复提示，安装有界且不回显 registry 凭据。",
      "浏览器请求、导出与授权刷新统一保留安全请求定位信息；网络写入结果未知时不自动重放。"
    ],
    "affectedUsers": [
      "使用 OpenXiangda 2.0 开发、交付或运行标准业务审批的应用。",
      "需要类型化 Native 资源绑定及业务角色候选的受管 Nest 扩展。"
    ],
    "upgradeSteps": [
      "应用固定 openxiangda@2.26.0，更新锁文件，重新生成契约并运行适用的 check/test。CLI 配套版本为 openxiangda-cli@2.5.20。",
      "先读取目标环境能力。启用原流程回执恢复需要 business-process.original-resolution@1.0.0；角色候选需要 directory.assignment-candidates@1.0.0。缺少能力时先升级目标服务端，不猜测接口。",
      "预发验证提交响应丢失、刷新后原键查询、已撤销权限拒绝，以及业务实际用到的资源与角色。复用同一已验收候选晋级。"
    ],
    "knownLimitations": [
      "未观察到原命令不证明事务回滚；恢复界面保留原键。刷新后不持久保存业务表单内容，也不自动重放未知写入。",
      "请求定位信息本身不授予读取后台日志或其他用户操作的权限。",
      "类型、诊断和本地工具改进不要求无关平台升级；新增服务端协议需目标明确公布对应能力。",
      "npm 发行验证不代替客户部署、真实角色或外部通知、签署和文件的业务验收。"
    ],
    "issues": [],
    "compatibility": {
      "node": ">=24",
      "workspaceGenerations": "v2",
      "platform": "保留现有平台基础协议；原流程恢复与受限角色候选按能力协商，分别需要 business-process.original-resolution@1.0.0 和 directory.assignment-candidates@1.0.0。",
      "v1": "独立 V1 引擎与工作区不受影响。"
    },
    "sha256": "a26725320f8477e8829fc0b22e50b67e4f54da7978c9b5972924f954fbb7891f",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.26.0"
  }
