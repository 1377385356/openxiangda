  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.49.10",
    "status": "reviewed",
    "title": "发起人审批策略与真实流程说明",
    "summary": "增加代码声明的发起人自动同意契约、能力协商和固定流程图说明，保持审批配置的有限修改边界。",
    "newFeatures": [
      "审批节点可声明 initiatorApprovalPolicy，默认 manual；auto_approve 只面向原解析产生的当前发起人直接席位。",
      "节点配置和固定流程图显示代码拥有的策略，执行图可读取持久化的自动审批证据。"
    ],
    "fixes": [
      "配置校验拒绝自动同意与强制同意意见、补填页面或可写字段的组合。",
      "同步托管媒体文档到随包 Skill 参考，保持开发资料同源。"
    ],
    "affectedUsers": [
      "重建多人审批、发起人与审批人重合业务以及维护固定流程配置的开发者和管理员。"
    ],
    "upgradeSteps": [
      "升级完整根包组合，并使用支持 workflow.initiator-approval-policy@1.0.0 的配套服务端。",
      "只为没有必填业务输入的审批节点显式声明 auto_approve；需要补选人员、补材料等节点继续使用 manual。"
    ],
    "knownLimitations": [
      "代理、转交、加签、管理员重分配和退回补正保持人工办理，不能用自动同意替代业务输入。",
      "不代表已精确复现宜搭 originatorMerge 的全部运行效果；真实源流程仍需逐条验收。",
      "本轮只进行本地配套分发，不发布 npm 或执行学校生产迁移。"
    ],
    "issues": [],
    "compatibility": {
      "node": ">=24",
      "platform": "新增显式能力协商；只有声明该策略的 V2 应用需要配套 Workflow 实现，默认人工和 1.x 保持原行为。"
    },
    "sha256": "b20657ae94bdda668654996d5f5f526ce3bda95df005327c959764d143ae23e4",
