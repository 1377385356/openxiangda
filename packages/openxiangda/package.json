  "openxiangdaRelease": {
    "schemaVersion": "openxiangda.release-notes/v1",
    "version": "2.22.2",
    "status": "reviewed",
    "title": "OpenXiangda 2.22.2：认证表单草稿原子提交与工作区状态",
    "summary": "为认证表单草稿补充具名业务流程原子消费，以及独立、版本化的草稿工作区状态合同，使正文编辑模式、范本选择和变量快照等临时状态可以在不放宽业务字段的前提下安全暂存。",
    "newFeatures": [
      "具名业务流程提交可以绑定一份认证表单草稿及其精确 revision，在同一平台事务内完成业务写入、流程命令和草稿消费；原幂等键可恢复既有结果，不重复创建业务记录或启动流程。",
      "默认表单和具名视图可分别声明有界 draftState Schema；浏览器 SDK 将 state 与业务 values 分离保存，并回读 Schema 版本、canonical digest 和已保存状态。"
    ],
    "fixes": [
      "草稿状态在声明撤销、范围收窄或版本和 digest 不一致时稳定失败，不会静默丢字段、误解释旧状态或把草稿字段加入 Data API 业务模型。",
      "公开合同、编译器、浏览器 SDK 和 Nest 业务流程客户端使用同一版本化合同，并继续保持 Node-only 校验代码不进入浏览器产物。"
    ],
    "affectedUsers": [
      "使用 OpenXiangda 2.0 自定义表单、具名视图、认证草稿或具名业务流程提交的应用开发者，以及负责升级对应平台服务的维护人员。"
    ],
    "upgradeSteps": [
      "将应用对 openxiangda 的精确依赖升级到 2.22.2，按锁文件重新安装依赖，并执行 pnpm openxiangda skill install --force 刷新本地 Skill。",
      "平台维护者需先升级到包含认证草稿原子消费和 draftState 支持的服务端版本，并按正式迁移流程应用新增的草稿状态列；应用应在目标环境回读有效 Schema 后再启用完整工作区草稿。"
    ],
    "knownLimitations": [
      "draftState 只保存受声明约束的临时工作区状态，不是业务 Data API 字段、工作流事实或永久文档存储；单份 state 上限为 192 KiB，values 与 state 合计上限为 256 KiB。",
      "仅升级 npm 包不会升级平台服务或执行数据库迁移；在平台尚未升级时，应用必须保留本地输入并显示失败，不得回退到 localStorage 冒充服务端草稿。"
    ],
    "issues": [],
    "compatibility": {
      "node": ">=24",
      "workspaceGenerations": "v2",
      "platform": "完整能力要求升级到支持认证草稿原子消费和 draftState Schema 的平台服务，并应用对应的 expand-only SQL migration；旧平台不会自动获得该能力。",
      "v1": "V1 工作区与维护引擎不受影响。"
    },
    "sha256": "5859a8c6ef4f6342f270d4d595df1ea7ef77e8421f4042646e4308eba41c2fbe",
    "url": "https://github.com/1377385356/openxiangda/releases/tag/v2.22.2"
  }
