{
  "name": "openxiangda-skill-kit",
  "version": "2.0.2",
  "description": "OpenXiangda 2.0 中文 AI 技能的校验、分发与安装。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "skills/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:release": "node ../../scripts/prune-package-dist.mjs && pnpm build",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build:release && node scripts/prepare-skills.mjs",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "openxiangda-devkit-core": "2.2.0"
  },
  "devDependencies": {
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1377385356/openxiangda.git",
    "directory": "packages/skill-kit"
  },
  "homepage": "https://github.com/1377385356/openxiangda",
  "bugs": {
    "url": "https://github.com/1377385356/openxiangda/issues"
  }
}
