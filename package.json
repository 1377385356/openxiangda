{
  "name": "openxiangda-v2-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "workspaces": [
    "packages/*",
    "templates/application/apps/*",
    "templates/application/packages/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=!openxiangda-application",
    "check": "turbo run check --filter=!openxiangda-application",
    "test": "turbo run test --filter=!openxiangda-application",
    "boundary:check": "node scripts/verify-v2-boundary.mjs",
    "orchestration:check": "node scripts/verify-workspace-orchestration.mjs",
    "verify": "pnpm boundary:check && pnpm orchestration:check && turbo run check test build --filter=!openxiangda-application",
    "verify:affected": "pnpm boundary:check && pnpm orchestration:check && turbo run check test build --affected --filter=!openxiangda-application",
    "verify:local": "pnpm verify && pnpm template:generated:check && node scripts/verify-packed-distribution.mjs && pnpm reference:smoke:from-build && pnpm skills:check:from-build && pnpm docs:build:from-build",
    "verify:release": "node scripts/release-publish.mjs --validate-only",
    "verify:release:full": "node scripts/release-publish.mjs --validate-only --full",
    "release:plan": "node scripts/release-plan.mjs",
    "release:plan:json": "node scripts/release-plan.mjs --json",
    "release:status": "changeset status",
    "release:version": "node scripts/release-version.mjs",
    "release:immutability": "node scripts/verify-release-immutability.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "release:publish:full": "node scripts/release-publish.mjs --full",
    "distribution:smoke": "pnpm build && node scripts/verify-packed-distribution.mjs",
    "distribution:smoke:from-build": "node scripts/verify-packed-distribution.mjs",
    "reference:smoke": "pnpm build && node scripts/verify-reference-application.mjs",
    "reference:smoke:from-build": "node scripts/verify-reference-application.mjs",
    "reference:update:from-build": "OPENXIANGDA_REFERENCE_UPDATE_GENERATED=1 node scripts/verify-reference-application.mjs",
    "reference:install:from-build": "OPENXIANGDA_REFERENCE_INSTALL_WORKTREE=1 node scripts/verify-reference-application.mjs",
    "release:sync-reference": "node scripts/sync-published-reference-lock.mjs --write",
    "release:check-reference": "node scripts/sync-published-reference-lock.mjs --check",
    "cli:local": "pnpm --filter openxiangda-cli build && node packages/cli/bin/run.js",
    "skills:check": "turbo run build --filter=openxiangda-skill-kit... && node packages/skill-kit/dist/bin.js skills",
    "skills:check:from-build": "node packages/skill-kit/dist/bin.js skills",
    "skills:install:local": "turbo run build --filter=openxiangda-skill-kit... && node packages/skill-kit/dist/bin.js install --source ./skills --force",
    "skills:manifest": "turbo run build --filter=openxiangda-skill-kit... && node packages/skill-kit/dist/bin.js skills --write-manifest",
    "docs:generate": "pnpm build && node scripts/generate-reference.mjs",
    "docs:generate:from-build": "node scripts/generate-reference.mjs",
    "docs:dev": "pnpm docs:generate && vitepress docs",
    "docs:build": "pnpm docs:generate && vitepress build docs",
    "docs:build:from-build": "pnpm docs:generate:from-build && vitepress build docs",
    "template:generated:check": "pnpm --filter openxiangda-cli... build && node scripts/verify-template-generated.mjs",
    "template:check": "pnpm template:generated:check && pnpm --dir templates/application check",
    "template:test": "pnpm --filter @app/web test",
    "template:test:e2e": "pnpm --filter @app/web test:e2e",
    "template:build": "pnpm --filter @app/web... build"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@types/node": "24.13.3",
    "turbo": "2.10.9",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitepress": "1.6.4"
  }
}
