{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": [
    "COREPACK_HOME",
    "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY",
    "http_proxy", "https_proxy", "all_proxy", "no_proxy",
    "npm_config_proxy", "npm_config_https_proxy", "npm_config_noproxy",
    "npm_config_registry", "npm_config_store_dir", "npm_config_cache_dir",
    "npm_config_prefer_offline", "npm_config_network_concurrency", "npm_config_fetch_retries",
    "npm_config_fetch_timeout", "npm_config_fetch_retry_mintimeout", "npm_config_fetch_retry_maxtimeout"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
